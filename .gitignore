# =============================================================================
# .gitignore — FCNN-MFIF  (Bhalla et al., JVCIR 2022)
# =============================================================================

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python
pip-log.txt
pip-delete-this-directory.txt
.installed.cfg

# ── Virtual environments ───────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.env

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Trained models / checkpoints (regenerable via train.py) ──────────────────
checkpoints/

# ── All datasets (archives, raw images, processed data, real test pairs) ──────
datasets/

# ── Fusion outputs (regenerable) ─────────────────────────────────────────────
outputs/

# ── Verification & plot artefacts ────────────────────────────────────────────
pipeline_verification_report.txt
pipeline_verification_plots.png
sample_raw_images.png

# ── OS / editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.code-workspace

# ── Logs & temp ───────────────────────────────────────────────────────────────
*.log
*.tmp
*.bak
/tmp/

# =============================================================================
# What IS tracked (committed to git):
# =============================================================================
#
#   model/          siamese_fcnn.py          — architecture
#   inference/      score_map.py             — SM/FM generation
#                   fusion.py                — full fusion pipeline
#   utils/          fuzzy_preprocessing.py   — S-membership fuzzification
#                   image_utils.py
#   scripts/        01–05_*.py               — dataset pipeline scripts
#                   ingest_*.py
#   train.py                                 — training loop (SGD, paper params)
#   verify_pipeline.py                       — pipeline health check
#   run_pipeline.sh                          — end-to-end shell script
#
# NOTE: No data is tracked. Regenerate everything with:
#   ./run_pipeline.sh
#
# =============================================================================
